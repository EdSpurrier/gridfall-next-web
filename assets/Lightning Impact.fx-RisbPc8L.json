    "material": {
     "code": "float kSmooth(float a, float b, float x) {\n  if (a == b) return x > a ? 1.0 : 0.0;\n  float t = clamp((x - a) / (b - a), 0.0, 1.0);\n  return t * t * (3.0 - 2.0 * t);\n}\nvec4 kSmooth4(float a, float b, vec4 x) { return vec4(kSmooth(a, b, x.x), kSmooth(a, b, x.y), kSmooth(a, b, x.z), kSmooth(a, b, x.w)); }\n// Amplify's rotator: (uv - 0.5) * float2x2(c, -s, s, c) + 0.5 (row vector times matrix).\nvec2 kRotate(vec2 uv, float a) {\n  vec2 q = uv - 0.5;\n  float c = cos(a), s = sin(a);\n  return vec2(q.x * c + q.y * s, -q.x * s + q.y * c) + 0.5;\n}\n// A fixed key light with wrap-around, for the surface (lit) shaders: billboards face the camera, so a\n// plain N.L would leave most of them in shadow.\nfloat kLight() {\n  float l = dot(normalize(vNormal), normalize(vec3(0.4, 0.8, -0.45)));\n  return 0.5 + 0.5 * (0.5 + 0.5 * l);\n}\nvec2 kUnpack(vec4 p, float scale) { return (vec2(p.r * p.a, p.g) * 2.0 - 1.0) * scale; }\nvec4 shadeFragment() {\n  vec2 uv = vTex0.xy;\n  float r = length((uv - 0.5) * 2.0);\n  float centerNoiseFade = kSmooth(0.0, 0.0, r);\n  float n = mix(0.0, (texture(mNoise1, uv * mNoise1_ST.xy + mNoise1_ST.zw + uTime * mNoiseSpeed1).r + texture(mNoise, uv * mNoise_ST.xy + mNoise_ST.zw + uTime * mNoiseSpeed).r) / 2.0, centerNoiseFade);\n  float noise = kSmooth(0.0, 0.426, n);\n  vec4 color = mix(mColor0, mColor1, noise);\n  float amount = 0.11 * kSmooth(-0.48, 0.33299999999999996, r);\n  vec2 duv = uv * mDistortion_ST.xy + mDistortion_ST.zw;\n  vec2 offset = kUnpack(texture(mDistortion, duv + uTime * mDistortionSpeed1), amount) + kUnpack(texture(mDistortion, duv * 0.5 + uTime * mDistortionSpeed2), amount);\n  float shape = kSmooth(0.0, 1.0, texture(mAlpha, uv * mAlpha_ST.xy + mAlpha_ST.zw + offset).r);\n  vec4 c = color * (shape * 1.0 * clamp(shape - noise, 0.0, 1.0)) * vColor;\n  // Dissolve: Custom1.x shows the flash from the centre out, Custom1.y hides it again.\n  float edge = 1.0 - r;\n  float soft = 0.5;\n  float dissolve = clamp(kSmooth(0.0, soft, edge + vTex0.w) + 1.0 - kSmooth(0.0, soft, edge + vTex0.z), 0.0, 1.0);\n  return vec4(c.rgb, clamp(c.a - dissolve, 0.0, 1.0));\n}",
