    "material": {
     "code": "vec4 shadeFragment() {\n  vec4 t0 = (m_GlowColor * vec4(vTex0.z));\n  vec2 t1 = vec2(m_NoisespeedXYNoisepowerZGlowpowerW.x, m_NoisespeedXYNoisepowerZGlowpowerW.y);\n  vec2 t2 = (t1 / m_Noise_ST.xy);\n  vec2 t3 = (vec2(uTime) * t2);\n  vec2 t4 = (vTex0.xy * vec2(1.0, 1.0) + t3);\n  vec4 t5 = texture(m_Noise, t4);\n  vec4 t6 = (t5 * vec4(m_NoisespeedXYNoisepowerZGlowpowerW.z));\n  vec2 t7 = ((t6).xy / m_MainTex_ST.xy);\n  vec2 t8 = (t7 + (vTex0).xy);\n  vec4 t9 = texture(m_MainTex, t8);\n  vec2 t10 = (t7 + (vTex1).xy);\n  vec4 t11 = texture(m_MainTex, t10);\n  vec4 t12 = mix(t9, t11, vec4(vTex1.z));\n  vec4 t13 = abs(t12);\n  vec4 t14 = pow(abs(t13), vec4(m_NoisespeedXYNoisepowerZGlowpowerW.w));\n  vec4 t15 = (t0 * t14);\n  vec4 t16 = clamp(t15, vec4(0.0, 0.0, 0.0, 0.0), vec4(10000.0));\n  vec4 t17 = (t16 + t12);\n  vec4 t18 = (t17 * m_Color);\n  vec4 t19 = (t18 * vColor);\n  vec4 t20 = (t19 * vec4(m_FinalEmission));\n  float t21 = (t12.w * m_Color.w);\n  float t22 = (t21 * vColor.w);\n  float t23 = (1.0 * 500.0);\n  vec4 t24 = vec4(gl_FragCoord.xy / uViewport, 0.0, 1.0);\n  float t25 = (t23 - t24.w);\n  float t26 = (t25 / m_Depthpower);\n  float t27 = clamp(t26, 0.0, 1.0);\n  float t28 = step(t27, (vec4(0.0, 0.0, 0.0, 0.0)).x);\n  float t29 = mix(t27, (vec4(1.0, 1.0, 1.0, 1.0)).x, t28);\n  float t30 = (t22 * t29);\n  float t31 = ((m_Usedepth > 0.5) ? t30 : t22);\n  float t32 = (t31 * m_Opacity);\n  vec3 baseColor = (t20).xyz;\n  vec3 emission = (t20).xyz;\n  float alpha = t32;\n\n  return vec4(baseColor + emission, alpha);\n}",
