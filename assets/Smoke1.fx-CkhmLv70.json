     "functions": "",
     "section": "vec3 sp = vec3(0.0);\nvec3 dir = vec3(0.0, 0.0, 1.0);\n{ float th = Rand(attributes.seed) * radians(360.0); float rr = sqrt(1.0 - 1.0 * Rand(attributes.seed));\n  vec2 n = vec2(cos(th), sin(th)) * rr;\n  sp = vec3(n * 0.1, 0.0);\n  dir = normalize(vec3(n * sin(radians(30.0)), cos(radians(30.0)))); }\nvec3 worldDir = normalize((vec4(dir, 0.0) * i_v0).xyz + vec3(0.0, 0.0, 1e-6));\nattributes.position = (vec4(sp, 1.0) * i_v0).xyz;\nattributes.velocity = worldDir * mix(2.0, 3.0, Rand(attributes.seed)) * 1.0;\nattributes.lifetime = max(mix(2.0, 4.0, Rand(attributes.seed)), 0.0001);\nattributes.startColor = vec4(0.18867922, 0.18867922, 0.18867922, 0.62352943);\nattributes.startSize = vec3(mix(4.0, 6.0, Rand(attributes.seed)));\nattributes.angle = vec3(0.0, 0.0, mix(0.0, 6.283185, Rand(attributes.seed)));\nattributes.texStart = 0.0;\nattributes.row = floor(Rand(attributes.seed) * 8.0);",
