     "functions": "",
     "section": "float dt = u_DeltaTime;\nfloat t = clamp(attributes.age / attributes.lifetime, 0.0, 1.0);\nfloat ageBefore = attributes.age;\nattributes.velocity.y -= 9.81 * 2.0 * dt;\nattributes.position += (attributes.velocity + vec3(0.0)) * dt;\n{ float radius = attributes.startSize.x * 0.005;\n  if (attributes.position.y < radius && attributes.velocity.y < 0.0) {\n    attributes.position.y = radius;\n    attributes.velocity.y = -attributes.velocity.y * 0.5;\n    attributes.velocity.xz *= 1.0 - 0.5;\n    attributes.age += attributes.lifetime * 0.0;\n    if (length(attributes.velocity) < 0.0) attributes.alive = false;\n  } }\nattributes.age += dt;\nif (attributes.age >= attributes.lifetime) attributes.alive = false;",
