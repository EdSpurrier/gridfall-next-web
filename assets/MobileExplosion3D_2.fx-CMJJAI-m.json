     "functions": "",
     "section": "float dt = u_DeltaTime;\nfloat t = clamp(attributes.age / attributes.lifetime, 0.0, 1.0);\nfloat ageBefore = attributes.age;\n{ float limit = 0.0;\n  float speed = length(attributes.velocity);\n  if (speed > limit && speed > 0.0) attributes.velocity *= mix(1.0, limit / speed, 1.0 - pow(1.0 - 0.15, dt * 30.0)); }\nattributes.position += (attributes.velocity + vec3(0.0)) * dt;\nattributes.age += dt;\nif (attributes.age >= attributes.lifetime) attributes.alive = false;",
     "events": [],
